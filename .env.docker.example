# Copy on Droplet: cp .env.docker.example .env
# Local Docker: same file as .env for compose

DJANGO_SETTINGS_MODULE=config.settings.docker
SECRET_KEY=change-me-use-python-c-import-secrets-print-secrets-token-urlsafe-50
DEBUG=False

POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=strong-password-here
DB_HOST=db
DB_PORT=5432

# Droplet IP + domain (when ready) + internal compose hostname web
ALLOWED_HOSTS=159.223.21.2,127.0.0.1,localhost,web
# Until domain: leave empty or http://159.223.21.2
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# HTTP until certbot; after SSL: USE_HTTPS=true, SITE_URL=https://your.domain
USE_HTTPS=false
SITE_URL=http://159.223.21.2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@lvivcup.com.ua
APPLICATION_NOTIFY_EMAIL=ruhcupleocup@gmail.com
